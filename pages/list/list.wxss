.gender-selector {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  width: 100%;
}

.radio-group {
  display: flex;
  gap: 30rpx;
}

.radio {
  display: flex;
  align-items: center;
}

.result-card {
  width: 100%;
  background: #e8f4fd;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  border: 1px solid #bde0ff;
  box-sizing: border-box;
}

.result-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 30rpx;
}
.result-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #666;
  width: 180rpx;
}

.value {
  color: #333;
  flex: 1;
}

.term {
  font-size: 40rpx;
  font-weight: bold;
  color: #1aad19;
}

.list-container {
  width: 100%;
  flex: 1;
}

.group {
  margin-bottom: 40rpx;
}

.group-title {
  font-size: 32rpx;
  color: #999;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
  border-left: 6rpx solid #1aad19;
}

.item-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.item-box {
  background: #fff;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 30rpx;
  color: #333;
  width: calc(33.333% - 14rpx);
  text-align: center;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
  box-sizing: border-box;
}

.item-box:active {
  background: #f0f0f0;
}