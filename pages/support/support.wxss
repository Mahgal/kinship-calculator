.support-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background-color: #fff;
  border-radius: 12rpx;
  width: 100%;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.thank-you-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.thank-you-msg {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.tip-qr {
  width: 400rpx;
  height: 400rpx;
  margin-bottom: 20rpx;
  background-color: #f8f8f8;
}

.tip-instruction {
  font-size: 24rpx;
  color: #999;
}