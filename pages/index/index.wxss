.gender-selector {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  width: 100%;
}

.radio-group {
  display: flex;
  gap: 30rpx;
}

.radio {
  display: flex;
  align-items: center;
}

.chain-display {
  width: 100%;
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  min-height: 100rpx;
  display: flex;
  align-items: center;
}

.chain-text {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.result-card {
  width: 100%;
  background: #e8f4fd;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 40rpx;
  border: 1px solid #bde0ff;
}

.result-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 30rpx;
}
.result-row:last-child {
  margin-bottom: 0;
}

.label {
  color: #666;
  width: 180rpx;
}

.value {
  color: #333;
  flex: 1;
}

.term {
  font-size: 40rpx;
  font-weight: bold;
  color: #1aad19;
}

.buttons-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
  gap: 20rpx;
}

.rel-btn {
  width: 45%;
  margin: 0 !important;
  background-color: #fff;
  color: #333;
  border: 1px solid #ddd;
  font-size: 32rpx;
}

.rel-btn[disabled] {
  background-color: #f0f0f0;
  color: #ccc;
}

.action-buttons {
  display: flex;
  width: 100%;
  justify-content: space-between;
  margin-top: 40rpx;
}

.action-btn {
  width: 45%;
  margin: 0 !important;
  font-size: 32rpx;
}

.undo {
  background-color: #f8f8f8;
  color: #333;
}

.reset {
  background-color: #e64340;
  color: #fff;
}

.support-link {
  margin-top: 60rpx;
  font-size: 24rpx;
  color: #999;
  text-decoration: underline;
}